# Mnemosyne /classifier schema — self-similar domain taxonomy
# Loaded by: Tools/SeedSchemas.ts (after epistemology, before scopes)
# Standing constraint: no CRLF — Cayley silently fails on \r.
#
# Design principle: self-similarity.
# Every classifier node IS a /type/type (can classify things) AND IS ITSELF
# classified by a parent. The inside_out_query pattern works identically
# at any level of this hierarchy — no special cases.
#
# Axes (orthogonal to ContextScope):
#   /classifier/entity        — things that exist
#   /classifier/process       — things that happen
#   /classifier/assertion     — claims about the world
#   /classifier/relationship  — how things connect

# ── Root classifier type ────────────────────────────────────────────────────
</classifier/kind> </type/object/type> </type/type> .
</classifier/kind> </type/object/name> "ClassifierKind" .
</classifier/kind> </common/topic/description> "Root of the self-similar classifier taxonomy. Every /classifier/* node is also a /type/type." .

# ── Axis: Entity ─────────────────────────────────────────────────────────────
</classifier/entity> </type/object/type> </classifier/kind> .
</classifier/entity> </type/object/type> </type/type> .
</classifier/entity> </type/object/name> "Entity" .
</classifier/entity> </common/topic/description> "A thing that exists — agent, artifact, concept, or place." .

</classifier/entity/agent> </type/object/type> </classifier/entity> .
</classifier/entity/agent> </type/object/type> </type/type> .
</classifier/entity/agent> </type/object/name> "Agent" .
</classifier/entity/agent> </common/topic/description> "Entity with agency. Further typed: conscious, collective, artificial." .

</classifier/entity/agent/conscious> </type/object/type> </classifier/entity/agent> .
</classifier/entity/agent/conscious> </type/object/type> </type/type> .
</classifier/entity/agent/conscious> </type/object/name> "ConsciousAgent" .
</classifier/entity/agent/conscious> </common/topic/description> "Agent with sentience. Humans, AI assistants, and (per scope) other claimants." .

</classifier/entity/agent/collective> </type/object/type> </classifier/entity/agent> .
</classifier/entity/agent/collective> </type/object/type> </type/type> .
</classifier/entity/agent/collective> </type/object/name> "CollectiveAgent" .
</classifier/entity/agent/collective> </common/topic/description> "Distributed agent: research team, AI ensemble, swarm, organization." .

</classifier/entity/agent/artificial> </type/object/type> </classifier/entity/agent> .
</classifier/entity/agent/artificial> </type/object/type> </type/type> .
</classifier/entity/agent/artificial> </type/object/name> "ArtificialAgent" .
</classifier/entity/agent/artificial> </common/topic/description> "Software agent — DA, LLM, MCP server, automated pipeline." .

</classifier/entity/artifact> </type/object/type> </classifier/entity> .
</classifier/entity/artifact> </type/object/type> </type/type> .
</classifier/entity/artifact> </type/object/name> "Artifact" .
</classifier/entity/artifact> </common/topic/description> "Entity made by an agent: document, model, recording, signal, codebase." .

</classifier/entity/concept> </type/object/type> </classifier/entity> .
</classifier/entity/concept> </type/object/type> </type/type> .
</classifier/entity/concept> </type/object/name> "Concept" .
</classifier/entity/concept> </common/topic/description> "Abstract entity: pattern, structure, principle, framework." .

</classifier/entity/place> </type/object/type> </classifier/entity> .
</classifier/entity/place> </type/object/type> </type/type> .
</classifier/entity/place> </type/object/name> "Place" .
</classifier/entity/place> </common/topic/description> "Location, region, environment, deployment target." .

