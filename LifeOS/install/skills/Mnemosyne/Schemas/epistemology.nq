</epistemology/verified> </type/object/name> "verified" .
</epistemology/verified> </epistemology/state_rank> "1" .
</epistemology/verified> </common/topic/description> "Prediction record is positive; independently replicated." .

</epistemology/putative> </type/object/type> </epistemology/epistemic_state> .
</epistemology/putative> </type/object/name> "putative" .
</epistemology/putative> </epistemology/state_rank> "2" .
</epistemology/putative> </common/topic/description> "Plausible, some supporting evidence, not yet stress-tested." .

</epistemology/speculative> </type/object/type> </epistemology/epistemic_state> .
</epistemology/speculative> </type/object/name> "speculative" .
</epistemology/speculative> </epistemology/state_rank> "3" .
</epistemology/speculative> </common/topic/description> "Structurally coherent, minimal direct evidence." .

</epistemology/contested> </type/object/type> </epistemology/epistemic_state> .
</epistemology/contested> </type/object/name> "contested" .
</epistemology/contested> </epistemology/state_rank> "4" .
</epistemology/contested> </common/topic/description> "Active conflict between supporting and contradicting evidence." .

</epistemology/debunked> </type/object/type> </epistemology/epistemic_state> .
</epistemology/debunked> </type/object/name> "debunked" .
</epistemology/debunked> </epistemology/state_rank> "5" .
</epistemology/debunked> </common/topic/description> "Falsification attempt succeeded. Preserved for provenance, never deleted." .

</epistemology/fictional> </type/object/type> </epistemology/epistemic_state> .
</epistemology/fictional> </type/object/name> "fictional" .
</epistemology/fictional> </epistemology/state_rank> "5" .
</epistemology/fictional> </common/topic/description> "True within a scoped narrative context; false outside it." .

</epistemology/emergent> </type/object/type> </epistemology/epistemic_state> .
</epistemology/emergent> </type/object/name> "emergent" .
</epistemology/emergent> </epistemology/state_rank> "2" .
</epistemology/emergent> </common/topic/description> "Arose from intersection of prior nodes; neither agent anticipated it alone." .

