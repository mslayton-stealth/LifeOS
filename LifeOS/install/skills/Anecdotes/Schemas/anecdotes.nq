</anecdote/anecdote/setup> </common/topic/description> "Situation establishment — who, where, when, what was at stake." .

</anecdote/anecdote/complication> </type/object/type> </type/property> .
</anecdote/anecdote/complication> </type/object/name> "complication" .
</anecdote/anecdote/complication> </type/property/schema> </anecdote/anecdote> .
</anecdote/anecdote/complication> </common/topic/description> "What went wrong, was unexpected, or unknown." .

</anecdote/anecdote/resolution> </type/object/type> </type/property> .
</anecdote/anecdote/resolution> </type/object/name> "resolution" .
</anecdote/anecdote/resolution> </type/property/schema> </anecdote/anecdote> .
</anecdote/anecdote/resolution> </common/topic/description> "What was actually done and how it played out." .

</anecdote/anecdote/insight> </type/object/type> </type/property> .
</anecdote/anecdote/insight> </type/object/name> "insight" .
</anecdote/anecdote/insight> </type/property/schema> </anecdote/anecdote> .
</anecdote/anecdote/insight> </common/topic/description> "The portable heuristic the anecdote teaches. May be implicit (left to reader) or explicit (stated in original)." .

</anecdote/anecdote/insight_explicit> </type/object/type> </type/property> .
</anecdote/anecdote/insight_explicit> </type/object/name> "insight_explicit" .
</anecdote/anecdote/insight_explicit> </type/property/schema> </anecdote/anecdote> .
</anecdote/anecdote/insight_explicit> </common/topic/description> "Literal 'true' or 'false'. True if the original text labels the lesson explicitly; false if extracted by inference." .

# ── Type: AnecdoteModality ───────────────────────────────────────────────────
</anecdote/modality> </type/object/type> </type/type> .
</anecdote/modality> </type/object/name> "AnecdoteModality" .
</anecdote/modality> </common/topic/description> "Form in which an anecdote is delivered. Determines parsing strategy and structural expectations." .

</anecdote/modality/dictated> </type/object/type> </anecdote/modality> .
</anecdote/modality/dictated> </type/object/name> "dictated" .
</anecdote/modality/dictated> </common/topic/description> "Oral, transcribed (canonical example: Twain Autobiography). Digressive; same story may re-enter from different angles." .

</anecdote/modality/reflective> </type/object/type> </anecdote/modality> .
</anecdote/modality/reflective> </type/object/name> "reflective" .
</anecdote/modality/reflective> </common/topic/description> "Written autobiography or memoir (canonical example: Franklin). Refined; moral often explicit." .

</anecdote/modality/curated> </type/object/type> </anecdote/modality> .
</anecdote/modality/curated> </type/object/name> "curated" .
</anecdote/modality/curated> </common/topic/description> "Curated personal narrative (canonical example: Feynman). Insight often implicit; reader infers heuristic." .

</anecdote/modality/dialectic> </type/object/type> </anecdote/modality> .
</anecdote/modality/dialectic> </type/object/name> "dialectic" .
</anecdote/modality/dialectic> </common/topic/description> "Multi-speaker knowledge construction (canonical example: Knuth Surreal Numbers). Insight emerges from dialogue; multiple ordered utterances." .

</anecdote/modality/interview> </type/object/type> </anecdote/modality> .
</anecdote/modality/interview> </type/object/name> "interview" .
</anecdote/modality/interview> </common/topic/description> "Live interview with a domain expert. Transcript-based; treat like dictated but with the interviewer's structure preserved." .

